# ---------------------------------------------------------------------------
# Touch Stone Properties — environment configuration
#
# These are SERVER-ONLY secrets. Never expose them to the client bundle and
# never commit real values (.env / .env.local are gitignored).
# In production (e.g. Vercel) configure the same keys in the dashboard.
# ---------------------------------------------------------------------------

# PostgreSQL Database Connection (required in production)
DATABASE_URL=postgresql://your_user:your_password@your_host:5432/your_database

# Set to "false" only if your PostgreSQL provider does NOT require SSL.
# Most managed providers (Neon, Supabase, RDS) need PGSSL=true.
PGSSL=false

# JWT Secret — REQUIRED IN PRODUCTION. The server refuses to sign/verify
# login tokens without it. Min 32 chars. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-strong-random-string

# Admin seed credentials (used by seed-admin.cjs only — never committed)
ADMIN_EMAIL=admin@touchstoneproperties.in
ADMIN_PASSWORD=ChangeThisToAStrongPassword

# Public base URL of the deployed site (used for canonical/OG URLs)
BASE_URL=https://touchstoneproperties.in

# Nitro deployment preset (optional). Default: node-server.
# Vercel: vercel | Cloudflare Pages: cloudflare_pages | Netlify: netlify
NITRO_PRESET=node-server
